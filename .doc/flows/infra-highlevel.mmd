flowchart TB
    subgraph Internet
        U1[Browser cliente]
        U2[Browser analista]
        U3[Browser admin]
        U4[WhatsApp Twilio]
    end

    subgraph Cloudflare
        CF[DNS A + wildcard A<br/>homeequity.digitalcodigos.com.br<br/>proxy desligado - DNS only]
    end

    U1 & U2 & U3 & U4 --> CF
    CF --> EIP[AWS Elastic IP<br/>56.126.112.30]

    subgraph AWS["AWS sa-east-1 · EC2 t4g.large ARM64 · 2 vCPU / 8 GB · 60 GB gp3"]
        direction TB
        EIP --> Caddy[Caddy 2 + plugin cloudflare<br/>10 vhosts · Basic-Auth<br/>TLS Lets Encrypt via DNS-01]

        subgraph App["Aplicação"]
            Caddy --> AppC[homeequity-agent<br/>FastAPI + Uvicorn<br/>SPA React /ui]
        end

        subgraph Stores["Stores principais"]
            PG[(homeequity-db<br/>Postgres 16 + pgvector)]
            CH[(homeequity-chromadb<br/>ChromaDB 0.6.3)]
            RD[(homeequity-redis<br/>Redis 7)]
        end
        AppC --> PG
        AppC --> CH
        AppC --> RD

        subgraph LLM["LLM providers externos"]
            OAI[OpenAI]
            GEM[Gemini]
            OR[OpenRouter ★]
            DS[DeepSeek]
            CO[Cohere]
        end
        AppC -.HTTPS.-> OAI & GEM & OR & DS & CO

        subgraph Search["Web search"]
            TV[Tavily API]
            DDG[DuckDuckGo]
        end
        AppC -.HTTPS.-> TV
        TV -.fallback.-> DDG

        subgraph Obs["Observabilidade · profile=monitoring"]
            OTC[OTel Collector]
            TMP[Tempo<br/>traces]
            PROM[Prometheus<br/>metrics]
            LOK[Loki<br/>logs]
            GR[Grafana 11]
            CADV[cAdvisor]
            NEXP[node-exporter]
        end
        AppC -.OTLP.-> OTC
        OTC --> TMP
        OTC --> PROM
        CADV & NEXP --> PROM
        OTC --> LOK
        TMP & PROM & LOK --> GR

        subgraph LF["LLM observability · profile=langfuse"]
            LFW[Langfuse web]
            LFWK[Langfuse worker]
            LFCH[(ClickHouse)]
            LFM[(MinIO)]
            LFDB[(Postgres langfuse)]
        end
        AppC -.SDK v3.-> LFW
        LFW & LFWK --> LFCH
        LFW & LFWK --> LFM
        LFW & LFWK --> LFDB
        LFWK --> RD

        subgraph Dev["Dev tools · profile=devtools"]
            MLF[MLflow tracking]
            RIN[RedisInsight]
            PGA[pgAdmin]
            PHX[Phoenix<br/>traces LLM]
            CADM[Chroma Admin]
        end
        AppC -.train.-> MLF
        Caddy --> GR
        Caddy --> LFW
        Caddy --> MLF
        Caddy --> PHX
        Caddy --> CADM
        CADM --> CH

        subgraph Volumes["Bind mounts /srv/homeequity/volumes/*"]
            V1[/postgres/]
            V2[/chromadb/]
            V3[/redis/]
            V4[/grafana · prometheus · loki · tempo/]
            V5[/langfuse-clickhouse · minio · db/]
            V6[/mlflow/]
        end
        PG --- V1
        CH --- V2
        RD --- V3
        GR --- V4
        LFCH --- V5
        MLF --- V6
    end

    subgraph IaC["IaC & Deploy"]
        TF[Terraform<br/>provision EC2 + EIP + SG]
        ANS[Ansible<br/>roles: bootstrap · docker · project · deploy]
        GH[GitHub madsonar/home-equity]
    end
    TF -.aws_instance.-> AWS
    ANS -.SSH.-> AWS
    GH -.git clone main.-> AppC

